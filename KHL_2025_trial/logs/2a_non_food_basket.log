. **# DATA PREPARATION 
. 
.     * Load dataset
.     use     "$rawdata/BLOK42_append.dta", clear  

.     
.     do      "$dofile/sub/0_labeling_susenas_kp42.do"

. 
. **# Labeling Susenas 
. 
.     label variable URUT     "Household ID"

.     label variable R101     "Provincial Code"

.     label variable R102     "District"

.     label variable R105     "Urban/Rural"

.     label variable R203     "Results of Household Enumeration"

.     label variable R301     "Number of Household Members"

.     label variable KLP      "Subgroup Code"

.     label variable KODE     "Commodity Item Number"

.     label variable B42K3    "Number of uses"

.     label variable B42K4    "Value of Household Expenditures in the Last Month"

.     label variable B42K5    "Value of Households Last Year's Expenditures"

.     label variable B42K3a   "Value of Spending in the Past Year in Household Paid in Cash"

.     label variable B42K3b   "Value of Spending in the Past Year in Household Paid in Cash"

.     label variable B42K3c   "Value of Spending in the Past Year in Household Paid in Cash"

.     label variable B42K3d   "Value of Spending in the Past Year in Household Paid in Cash"

.     label variable B42K3e   "Value of Spending in the Past Year in Household Paid in Cash"

.     label variable SEBULAN  "Average Non-Food Spending Value for a Month Household"

.     label variable WERT     "Weighing for Household Estimates"

.     label variable WEIND    "Weighing for Population Estimation"

.     label variable KABU     "Regency"

.     //label variable WI1      "Indonesian NKS serial number"
.     //label variable WI2      "Serial number for household samples in Indonesia"
. 
end of do-file

.     drop    if KLP==0
(1,771,527 observations deleted)

. 
.     * Monthly Expenditures
.     // The survey reports monthly and yearly expenses for each item
.     gen     monthly_exp = B42K4

.     replace monthly_exp = B42K5/12 if B42K4 == 0  
(7,315,915 real changes made)

. 
