. **# Labeling Susenas 
. 
.     label   variable    URUT        "Variables For Merging Data"   

.     label   variable    R101        "Province"

.     label   variable    R102        "Regency / city"

.     label   variable    R105        "Area type"

.     label   variable    R301        "Number of household members"

.     label   variable    NUINFORT    "Information giver serial number"

.     label   variable    NUINFORT1   "Information giver serial number"

.     label   variable    R1602       "What is the ownership status of the occupied building?"

.     label   variable    R1604       "What is the floor area of the residential building?"

.     label   variable    R1606       "What is the main building material for the widest roof of the house?"

.     label   variable    R1607       "Is the main building material of the widest wall of the house"

.     label   variable    R1608       "What is the main building material for the widest floor of the house?"

.     label   variable    R1609B      "What type of toilet is used?"

.     label   variable    R1609C      "Where is the final disposal site for feces?"

.     label   variable    R1610A      "What is the main source of water used for drinking?"

.     label   variable    WERT        "Weighing for Household Estimates"

.     label   variable    WEIND       "Weighing for Population Estimation"

. 
. 
. 
end of do-file

